{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/Happy-Halloween-2026/blob/main/schemas/collection.schema.json",
  "title": "Happy Halloween 2026 Collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection", "maintainer", "tagline", "projects", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "collection": {"type": "string", "minLength": 1},
    "maintainer": {"type": "string", "minLength": 1},
    "tagline": {"type": "string", "minLength": 1},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "repository", "purpose", "human_guide", "agent_guide"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "format": "uri"},
          "purpose": {"type": "string", "minLength": 1},
          "human_guide": {"type": "string", "format": "uri"},
          "agent_guide": {"type": "string", "format": "uri"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
